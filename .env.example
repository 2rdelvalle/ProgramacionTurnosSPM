# ============================================================
# Plantilla de variables de entorno — SIN valores reales.
# Copia este archivo a .env y completa los valores antes
# de iniciar la aplicacion en local.
# El archivo .env nunca debe commitearse (ver .gitignore).
# ============================================================

# --- Base de datos ---
DB_URL=jdbc:postgresql://localhost:5432/programacion_db
DB_USER=postgres
DB_PASSWORD=

# --- Perfil Spring activo ---
# Para desarrollo local usa 'dev'; produccion requiere 'prod'
# o configuracion externa sin perfil de desarrollo.
SPRING_PROFILES_ACTIVE=dev

# --- Usuarios de arranque (solo perfil dev) ---
# app.inicializador.habilitado=true debe estar en application-dev.properties
# Define claves unicas por entorno; nunca uses 'basico' fuera de tu maquina.
INIT_TH_USUARIO=th
INIT_TH_CLAVE=

INIT_OPE_USUARIO=operaciones
INIT_OPE_CLAVE=

INIT_ADU_USUARIO=basculas
INIT_ADU_CLAVE=

# --- Propiedad deprecada (compatibilidad) ---
# 'app.inicializador.thclave' fue el nombre original de INIT_TH_CLAVE.
# Usa INIT_TH_CLAVE (app.inicializador.th.clave) en los nuevos despliegues.
# APP_INICIALIZADOR_THCLAVE=  <-- no usar en despliegues nuevos

# --- SMS (solo si el puerto real esta activo) ---
# SMS_API_KEY=
# SMS_API_URL=
